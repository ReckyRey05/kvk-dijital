rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. DEFAULT DENY: Block all undefined collection paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Verified Corporate Admin Authorization Helper Function
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'alihaydarkvk@kvkdijitalcozumler.com' ||
          request.auth.token.email == 'iletisim@kvkdijitalcozumler.com' ||
          request.auth.token.email.matches('.*@kvkdijitalcozumler\\.com$')
        );
    }

    // 2. PUBLIC READ COLLECTIONS
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. CONTACT MESSAGES (Admin read/update/delete, Browser direct create DENY)
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // 4. TEKLIFIM GELSIN / TOPTANCIM CEBIMDE B2B MARKETPLACE
    match /teklifim_profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == profileId || isAdmin());
    }

    match /teklifim_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.businessId == request.auth.uid || isAdmin());
    }

    match /teklifim_offers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.supplierId == request.auth.uid || isAdmin());
    }

    match /teklifim_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.businessId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teklifim_verifications/{verificationId} {
      allow read: if request.auth != null && (resource.data.supplierId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.supplierId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teklifim_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teklifim_blocks/{blockId} {
      allow read, write: if request.auth != null && (resource.data.blockerId == request.auth.uid || request.resource.data.blockerId == request.auth.uid || isAdmin());
    }

    match /teklifim_notifications/{notifId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    // 5. FAZ 4: İLETİŞİM, PAZARLIK & ANLAŞMA SİSTEMİ
    match /teklifim_conversations/{convId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
    }

    match /teklifim_messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teklifim_offer_versions/{versionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /teklifim_agreements/{agreementId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 6. FAZ 5: SİPARİŞ, TESLİMAT & İŞLEM YÖNETİMİ
    match /teklifim_orders/{orderId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 7. FAZ 6: ÖDEME, FİNANS & FATURALANDIRMA
    match /teklifim_payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_invoices/{invoiceId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow create, update: if request.auth != null && (request.resource.data.supplierId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /teklifim_payouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.supplierId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // 8. FAZ 7: ÜRÜN KATALOĞU, STOK & TEDARİKÇİ TİCARET MERKEZİ
    match /teklifim_products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.supplierId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.supplierId == request.auth.uid || isAdmin());
    }

    match /teklifim_product_favorites/{favId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /teklifim_favorites/{favId} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // 9. FAZ 8: KEŞİF, ARAMA & AKILLI MARKETPLACE
    match /teklifim_saved_searches/{searchId} {
      allow read, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /teklifim_search_history/{historyId} {
      allow read, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 10. FAZ 9: İŞLETME SATIN ALMA, EKİP & KURUMSAL ALIM SİSTEMİ
    match /teklifim_team_members/{memberId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_team_invitations/{invitationId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_procurement_lists/{listId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (resource.data.businessId == request.auth.uid || request.resource.data.businessId == request.auth.uid || isAdmin());
    }

    match /teklifim_procurement_policies/{policyId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_audit_logs/{logId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if false; // IMMUTABLE AUDIT TRAIL
    }

    // 11. FAZ 10: TOPTANCI İŞLETME MERKEZİ & SATIŞ BÜYÜME SİSTEMİ
    match /teklifim_quote_templates/{templateId} {
      allow read, write: if request.auth != null && (resource.data.supplierId == request.auth.uid || request.resource.data.supplierId == request.auth.uid || isAdmin());
    }

    match /teklifim_price_lists/{listId} {
      allow read, write: if request.auth != null && (resource.data.supplierId == request.auth.uid || request.resource.data.supplierId == request.auth.uid || isAdmin());
    }

    // 12. FAZ 11: ENTEGRASYONLAR, API & OTOMASYON PLATFORMU
    match /teklifim_api_keys/{keyId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /teklifim_webhook_endpoints/{endpointId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /teklifim_webhook_deliveries/{deliveryId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_notification_preferences/{userId} {
      allow read, write: if request.auth != null && (userId == request.auth.uid || isAdmin());
    }

    match /teklifim_consents/{consentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teklifim_integration_events/{eventId} {
      allow read: if request.auth != null && (resource.data.recipientId == request.auth.uid || resource.data.actorId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /teklifim_integration_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 13. FAZ 12: ADMIN & PLATFORM OPERASYON MERKEZI
    match /teklifim_disputes/{disputeId} {
      allow read: if request.auth != null && (resource.data.businessId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /teklifim_support_tickets/{ticketId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /teklifim_moderation_notes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /teklifim_feature_flags/{flagKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teklifim_platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teklifim_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teklifim_admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // IMMUTABLE AUDIT TRAIL
    }

    match /teklifim_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

