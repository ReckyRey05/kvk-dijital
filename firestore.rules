rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. DEFAULT DENY: Block all undefined collection paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Verified Corporate Admin Authorization Helper Function
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'alihaydarkvk@kvkdijitalcozumler.com' ||
          request.auth.token.email == 'iletisim@kvkdijitalcozumler.com' ||
          request.auth.token.email.matches('.*@kvkdijitalcozumler\\.com$')
        );
    }

    // 2. PUBLIC READ COLLECTIONS
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. CONTACT MESSAGES (Admin read/update/delete, Browser direct create DENY)
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

  }
}
